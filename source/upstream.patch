+watch(()=>[props.movieId,auth.isAuthenticated,props.revision],async()=>{const id=++generation;error.value='';message.value='';state.value={favorite:false,seen:false};suggestions.value=[];if(!auth.isAuthenticated)return;busy.value=true;try{const d=await request('GET');if(id===generation){state.value=d;await refreshRecommendations(id)}}catch(e){if(id===generation)error.value=e.message}finally{if(id===generation)busy.value=false}},{immediate:true})
